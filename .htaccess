# The application root is private. Serve this project through public/.
# Prefer a virtual host pointing at public/; also protect XAMPP's /Portfolio URL.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ %{REQUEST_URI}public/ [R=302,L]
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^ - [F,L]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
